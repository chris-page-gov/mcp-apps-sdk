{
  "name": "mcp-apps-sdk",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "forwardPorts": [
    3000,
    4444,
    8000,
    8002
  ],
  "postCreateCommand": "git submodule update --init --recursive && corepack enable pnpm && pnpm install && python -m pip install --upgrade pip && pip install -r examples/openai-apps-sdk-examples/solar-system_server_python/requirements.txt",
  "remoteUser": "vscode",
  "remoteEnv": {
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
  }
}
